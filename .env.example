# ---------------------------------------------------------------
# All keys are read server-side only. Never prefix them with NEXT_PUBLIC_.
# ---------------------------------------------------------------

# Market data + option chains with greeks (quotes, daily/weekly/monthly bars,
# 1/5/15-minute bars, expirations, chains). Free sandbox token = 15-min delayed data.
# A brokerage-account production token = real-time data.
TRADIER_TOKEN=
TRADIER_ENV=sandbox            # sandbox | production

# News, company profile, fundamentals, analyst recommendations, insider
# transactions, earnings calendar. https://finnhub.io (free key works; some
# endpoints such as upgrades/downgrades need a premium plan and are reported as such).
FINNHUB_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact email.
# Format: "AppName your-email@example.com"
SEC_USER_AGENT=

# Claude: news impact analysis, verification labelling and the plain-English verdict.
# Without it, a transparent lexicon heuristic is used and labelled as such.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Model assumptions (labelled in the UI as assumptions, not market data)
RISK_FREE_RATE=0.04            # annualized, used by Black-Scholes

# Background monitoring of the watchlist (runs inside the Next.js server process)
MONITOR_ENABLED=false
MONITOR_INTERVAL_SECONDS=300

# Where the SQLite research-history database lives
DATABASE_PATH=./data/research.db
